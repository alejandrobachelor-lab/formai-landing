# Database - Supabase Configuration
# Get these values from your Supabase project: Settings → Database → Connection string

# Transaction pooler URL (for serverless functions like Next.js API routes)
# Port: 6543, add ?pgbouncer=true parameter
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection URL (for Prisma migrations)
# Port: 5432 for session pooler
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Instructions:
# 1. Create a project at https://supabase.com
# 2. Go to Settings → Database
# 3. Find "Connection string" section
# 4. Copy "Transaction pooler" URL (port 6543) for DATABASE_URL
# 5. Copy "Session pooler" URL (port 5432) for DIRECT_URL
# 6. Replace [YOUR-PASSWORD] with your actual database password

# OpenAI API Configuration
# For AI-powered form conversations

# OpenAI API key from https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-proj-..."

# Instructions:
# 1. Go to https://platform.openai.com/api-keys
# 2. Create a new API key
# 3. Copy and paste it as OPENAI_API_KEY

# Telegram Bot Configuration
# For sending form submission notifications to Telegram

# Bot token from @BotFather
TELEGRAM_BOT_TOKEN="your_bot_token_here"

# Default chat ID (can be overridden per form)
TELEGRAM_CHAT_ID="your_chat_id_here"

# Instructions:
# 1. Create a bot via @BotFather on Telegram
# 2. Copy the bot token and paste it as TELEGRAM_BOT_TOKEN
# 3. Get your chat ID by messaging @userinfobot or your bot
# 4. Paste the chat ID as TELEGRAM_CHAT_ID
